{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"$CLAUDE_PROJECT_DIR/scripts/lint-edited-file.ts\"",
            "timeout": 60,
            "statusMessage": "Linting the edited file"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node --no-warnings \"$CLAUDE_PROJECT_DIR/scripts/check-before-stop.ts\"",
            "timeout": 300,
            "statusMessage": "Running the checks before finishing"
          }
        ]
      }
    ]
  }
}
