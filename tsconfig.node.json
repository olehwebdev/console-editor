{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node",
      "electron-vite/node"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "test/**/*",
    "scripts/**/*",
    "electron.vite.config.ts",
    "electron-builder.ts",
    "vitest.config.mts",
    "vitest.e2e.config.mts",
    "vitest.perf.config.mts"
  ],
  "exclude": [
    "test/renderer/**/*",
    "test/fixtures/apps/**/*",
    "test/perf/apps/**/*"
  ]
}
