{
  "name": "console-editor",
  "productName": "Console Editor",
  "version": "0.3.0",
  "private": true,
  "description": "Desktop editor for live-patching the JS/CSS/HTML of any website (including cross-site iframes) without rebuilding it.",
  "keywords": [
    "devtools",
    "debugging",
    "live-editing",
    "chrome-devtools-protocol",
    "electron",
    "monaco-editor",
    "overrides",
    "iframes"
  ],
  "homepage": "https://github.com/olehwebdev/console-editor#readme",
  "bugs": {
    "url": "https://github.com/olehwebdev/console-editor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olehwebdev/console-editor.git"
  },
  "license": "MIT",
  "author": "olehwebdev",
  "main": "./out/main/index.js",
  "desktopName": "console-editor.desktop",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && vitest run -c vitest.e2e.config.mts",
    "dist": "electron-vite build && electron-builder --publish never",
    "test:packaged": "node --no-warnings test/smoke/packaged.ts",
    "test:update": "node --no-warnings test/smoke/update.ts",
    "demo-site": "node --no-warnings test/fixtures/site.ts",
    "lint:fsd": "steiger ./src/renderer/src",
    "lint:structure": "node --no-warnings scripts/check-structure.ts",
    "lint:unused": "knip",
    "lint:duplicates": "jscpd src scripts --format typescript,tsx --baseline .jscpd-baseline.json --fail-on-new-clones --reporters console"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@babel/types": "^7.29.8",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.16.1",
    "electron-vite": "^6.0.0-beta.1",
    "jscpd": "^5.3.2",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "playwright-core": "^1.63.0",
    "steiger": "^0.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@tanstack/react-virtual": "^3.14.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "js-beautify": "^2.0.3",
    "marked": "^18.0.14",
    "monaco-editor": "^0.56.0",
    "motion": "^13.4.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "overrides": {
    "dompurify": "$dompurify"
  }
}
